# Copy to .env for local development. .env is gitignored.
#
# Deploying instead of developing? The hosted backend takes its configuration
# from the platform, not from this file -- see RAILWAY.md. The notes below each
# section say what has to change when NODE_ENV=production.

# ---- Server ----
NODE_ENV=development
# Railway and most PaaS providers inject PORT. Do not set it there.
PORT=4000
API_PREFIX=/api

# ---- Database ----
# SQLite (default, zero-setup). For PostgreSQL change provider in prisma/schema.prisma
# to "postgresql" and use e.g. postgresql://user:pass@localhost:5432/rentoni
#
# In production this path must live on persistent storage. Container
# filesystems are wiped on redeploy, and because `npm start` now runs
# `prisma migrate deploy`, a lost SQLite file is silently recreated EMPTY --
# which looks like a working site with every product gone.
DATABASE_URL="file:./dev.db"

# ---- Auth ----
# These dev values are fine locally. In production both are REQUIRED and must be
# >= 32 chars -- the process exits on startup otherwise, so never set
# NODE_ENV=production without setting them in the same change.
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="dev-access-secret-change-me-0123456789abcdef"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-0123456789abcdef"
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=10

# ---- CORS ----
# Scheme + host + port only, no trailing slash. An unlisted origin gets a 403.
#
# Outside production, any loopback or private-network origin is also accepted so
# that browsing via 127.0.0.1 or a LAN IP works without editing this list. In
# production ONLY this list applies, so it must name the real frontend origin
# (e.g. https://rentoni.uz,https://www.rentoni.uz) when the frontend is served
# from a different host than the API.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# ---- Seed / bootstrap SUPER_ADMIN ----
# Unlike the JWT secrets, these have fallbacks that do NOT fail loudly in
# production. Override them before seeding a real store.
SUPER_ADMIN_EMAIL="admin@rentoni.test"
SUPER_ADMIN_PASSWORD="Admin@12345"
SUPER_ADMIN_NAME="Store Owner"
# Required to use POST /api/auth/bootstrap-admin when no SUPER_ADMIN exists yet.
# Unset or empty means the endpoint rejects every token. Clear it again once the
# first SUPER_ADMIN account exists.
ADMIN_SETUP_TOKEN="dev-setup-token-change-me"
