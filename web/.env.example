# Copy to .env.local to override the API target for your own machine.
# .env.local is gitignored; .env.production is the committed production default.

# Where the browser sends API calls in a PRODUCTION BUILD.
# Unset -> "/api" (same-origin; requires a reverse proxy in front).
VITE_API_URL=https://rentoni-production.up.railway.app/api

# Where the DEV SERVER proxies /api to. Only used by `npm run dev`.
# Because the browser still talks to the Vite origin, this path never triggers
# CORS -- handy for developing against the deployed backend.
# Unset -> http://localhost:4000
VITE_API_PROXY=http://localhost:4000
